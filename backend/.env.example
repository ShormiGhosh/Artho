# Database
DATABASE_URL=postgresql://artho:artho@localhost:5544/artho
DB_POOL_MIN=2
DB_POOL_MAX=20

# Server
NODE_ENV=development
PORT=3000

# JWT — short-lived access token; session length comes from the refresh token
JWT_SECRET=dev-super-secret-key-min-32-chars-change-me-please
JWT_EXPIRATION=900
REFRESH_TOKEN_TTL_DAYS=30

# CORS
CORS_ORIGIN=http://localhost:5173

# Behaviour
INITIAL_BALANCE_PAISA=10000000

# Security (generate strong random values in production)
PII_ENCRYPTION_KEY=dev-pii-key-000000000000000000000000000000000000000000000000000000
PII_BLIND_INDEX_KEY=dev-blind-index-key-change-me-in-production
# Reject plain HTTP (set true when a TLS-terminating proxy sits in front)
ENFORCE_HTTPS=false

# OpenAI — advisory AI layer (Transaction Investigator, Fraud Analysis, Summaries).
# Leave OPENAI_API_KEY blank to run the app with deterministic fallbacks only.
# The key is server-side only and is never logged, stored, or sent to the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=12000
OPENAI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MIN=12

# Email verification. Leave SMTP_* blank to run in dev fallback (the code is
# logged, and echoed in the API response outside production) instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Artho <no-reply@artho.app>
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_S=60
